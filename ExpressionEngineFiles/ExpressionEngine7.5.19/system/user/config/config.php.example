$config['app_version'] = '7.5.19';
$config['encryption_key'] = ''; // Will be generated during installation
$config['site_name'] = 'Van Alstyne CEDC';

// Database settings - these match the Ansible deployment
$config['database'] = array(
    'expressionengine' => array(
        'hostname' => 'localhost',
        'database' => 'vanalstyne',
        'username' => 'vanalstyne',
        'password' => 'YOUR_PASSWORD_HERE',  // Use same password as vault_van_alstyne_db_pass
        'dbprefix' => 'exp_',
        'char_set' => 'utf8mb4',
        'dbcollat' => 'utf8mb4_unicode_ci',
        'port'     => ''
    ),
);

// Site URL settings - UPDATE THESE FOR YOUR ENVIRONMENT
// Staging:
$config['site_url'] = 'https://van-alstyne.younger.host/';
$config['cp_url'] = 'https://van-alstyne.younger.host/admin.php';

// Production (uncomment these and comment out staging when going live):
// $config['site_url'] = 'https://vaedc.com/';
// $config['cp_url'] = 'https://vaedc.com/admin.php';

